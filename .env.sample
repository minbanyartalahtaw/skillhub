# Copy to .env and fill in real values: cp .env.sample .env

# --- MongoDB container (docker-compose.yml) ---
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=password
MONGO_DB=skillhub
MONGO_PORT=27017

# --- App ---
# Must match the credentials above. authSource=admin because the root user
# is created in the admin database, not in MONGO_DB.
MONGODB_URI=mongodb://root:password@localhost:27017/skillhub?authSource=admin

# Secret for signing session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
